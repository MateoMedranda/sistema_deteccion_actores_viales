MODEL_WEIGHTS_PATH=C:/secure-models/yolov10s_best.pt
ULTRALYTICS_PATH=
API_KEY=replace-with-a-long-random-secret
# Optional multi-principal format: analyst-a:secret-a,analyst-b:secret-b
API_KEYS=
MODEL_CONFIDENCE_THRESHOLD=0.25
INFERENCE_DEVICE=0
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=16000000
ARTIFACT_TTL_SECONDS=900
MAX_CONCURRENT_INFERENCES=1
TEMP_ARTIFACT_DIR=.runtime/artifacts
MAX_VIDEO_UPLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=120
MAX_VIDEO_WIDTH=1920
MAX_VIDEO_HEIGHT=1080
MAX_VIDEO_FPS=30
MAX_VIDEO_FRAMES=3600
MAX_CONCURRENT_VIDEO_JOBS=1
MAX_QUEUED_VIDEO_JOBS=20
VIDEO_JOB_TIMEOUT_SECONDS=300
VIDEO_RESULT_TTL_SECONDS=3600
VIDEO_JOB_DB_PATH=.runtime/video-jobs.sqlite3
VIDEO_TEMP_DIR=.runtime/video-jobs
FFPROBE_EXECUTABLE=ffprobe
FFMPEG_EXECUTABLE=ffmpeg
ATTRIBUTE_MODEL_WEIGHTS_PATH=C:/secure-models/multitask_epoch_20.pth
ATTRIBUTE_MODEL_MANIFEST_PATH=specs/004-extraccion-caracteristicas-y-placas/model-manifest.example.yaml
PLATE_MODEL_WEIGHTS_PATH=C:/secure-models/alpr_yolov8n_best.pt
PADDLE_OCR_LANG=en
ENRICHMENT_RESULT_TTL_SECONDS=900
ENRICHMENT_JOB_DB_PATH=.runtime/enrichment-jobs.sqlite3
ENRICHMENT_TEMP_DIR=.runtime/enrichment
MAX_CONCURRENT_ENRICHMENT_JOBS=1
MAX_QUEUED_ENRICHMENT_JOBS=20
MAX_CONCURRENT_ATTRIBUTE_INFERENCES=1
MAX_CONCURRENT_PLATE_INFERENCES=1
VEHICLE_CLASSES=car,truck,bus,van,pickup,suv,sedan,hatchback,mpv,estate
MAX_EVIDENCE_FRAMES_PER_TRACK=3
PLATE_LOCALIZER_THRESHOLD=0.25
PLATE_OCR_RETRY_THRESHOLD=0.70
PLATE_OCR_ACCEPT_THRESHOLD=0.80
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Progressive playback; these do not alter upload duration or computation timeout.
VIDEO_PROGRESSIVE_BATCH_FRAMES=15
VIDEO_PROGRESSIVE_BATCH_SECONDS=0.5
VIDEO_PROGRESSIVE_BUFFER_SECONDS=5

# Progressive video only: 1 = detect every frame, 2 = detect alternating frames + Kalman prediction.
VIDEO_DETECTION_INTERVAL=2
