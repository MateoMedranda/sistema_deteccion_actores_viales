{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specs/011/count-lines.schema.json",
  "title": "Video multiline counts 011 design",
  "$defs": {
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point_a": {
          "$ref": "#/$defs/Point"
        },
        "point_b": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "point_a",
        "point_b"
      ]
    },
    "LineWrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "segment": {
          "$ref": "#/$defs/Segment"
        }
      },
      "required": [
        "line_id",
        "name",
        "color",
        "segment"
      ]
    },
    "LineConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "segment": {
          "$ref": "#/$defs/Segment"
        },
        "geometry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "origin": {
          "type": "string",
          "enum": [
            "user",
            "legacy_import"
          ]
        }
      },
      "required": [
        "line_id",
        "name",
        "color",
        "segment",
        "geometry_revision",
        "origin"
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_active_lines": {
          "type": "integer",
          "minimum": 10,
          "maximum": 32
        },
        "max_admitted_lines": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1024
        },
        "max_name_graphemes": {
          "type": "integer",
          "const": 60
        },
        "max_name_utf8_bytes": {
          "type": "integer",
          "const": 2048
        },
        "max_name_codepoints": {
          "type": "integer",
          "const": 1024
        }
      },
      "required": [
        "max_active_lines",
        "max_admitted_lines",
        "max_name_graphemes",
        "max_name_utf8_bytes",
        "max_name_codepoints"
      ]
    },
    "LegacyImportState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "offered",
            "imported"
          ]
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "line_id"
      ]
    },
    "CollectionWrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "format": "uuid"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/LineWrite"
          }
        }
      },
      "required": [
        "generation",
        "expected_revision",
        "lines"
      ]
    },
    "LegacyImport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "format": "uuid"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "generation",
        "expected_revision"
      ]
    },
    "Collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "generation": {
          "type": "string",
          "format": "uuid"
        },
        "protocol": {
          "type": "string",
          "const": "video-count-lines-v1"
        },
        "policy_version": {
          "type": "string",
          "const": "finite-center-both-v1"
        },
        "mode": {
          "type": "string",
          "const": "both"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "default_colors": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "lines": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/LineConfig"
          }
        },
        "legacy_import": {
          "$ref": "#/$defs/LegacyImportState"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "admitted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "job_id",
        "generation",
        "protocol",
        "policy_version",
        "mode",
        "revision",
        "limits",
        "default_colors",
        "lines",
        "legacy_import",
        "expires_at",
        "admitted_count"
      ]
    },
    "CountValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "type": "string",
          "format": "uuid"
        },
        "geometry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "unavailable"
          ]
        },
        "result_scope": {
          "type": "string",
          "enum": [
            "building",
            "partial",
            "final"
          ]
        },
        "covered_until_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "reanalysis_required",
                "count_work_limit",
                "count_reducer_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "line_id",
        "geometry_revision",
        "status",
        "result_scope",
        "covered_until_us",
        "total",
        "error_code",
        "valid_until_us"
      ]
    },
    "CountSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "generation": {
          "type": "string",
          "format": "uuid"
        },
        "protocol": {
          "type": "string",
          "const": "video-count-lines-v1"
        },
        "policy_version": {
          "type": "string",
          "const": "finite-center-both-v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "at_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "available_until_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "analysis_state": {
          "type": "string",
          "enum": [
            "queued",
            "analyzing",
            "complete",
            "partial_failed"
          ]
        },
        "lines": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/CountValue"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "job_id",
        "generation",
        "protocol",
        "policy_version",
        "revision",
        "at_us",
        "available_until_us",
        "analysis_state",
        "lines",
        "expires_at"
      ]
    }
  }
}
